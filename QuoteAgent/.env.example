# Everything below has a working default. Copy this file to .env only to
# change something.

# --- database -----------------------------------------------------------
# SQLite by default, so a reviewer needs nothing installed.
# PostgreSQL 16:  DATABASE_URL=postgresql+psycopg://quoteagent:quoteagent@localhost:5432/quoteagent
# DATABASE_URL=sqlite:///./backend/var/quoteagent.db

# --- reasoning engine ---------------------------------------------------
# Leave the key empty and the built-in engine reads requests: no key, no
# network, no cost. Set it and the same step runs through Claude, with every
# call listed on the case timeline with its tokens and its cost.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
REASONING_BUDGET_USD_PER_CASE=0.50

# --- sign-in ------------------------------------------------------------
# Change this for anything that is not a demonstration.
JWT_SECRET=demo-only-change-me-in-production
ACCESS_TOKEN_MINUTES=720

# --- company policy, which a client would own ---------------------------
BASE_CURRENCY=TWD
QUOTE_VALIDITY_DAYS=14
FOREIGN_EXCHANGE_LOCK_DAYS=14
DIRECTOR_APPROVAL_THRESHOLD_TWD=1500000
DEFAULT_MARGIN_FLOOR_PERCENT=18

# --- where the interface lives -----------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

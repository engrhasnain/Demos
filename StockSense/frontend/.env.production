# Production builds talk to the backend on the same origin: the root
# vercel.json sends /api/* to the backend service and everything else to
# this interface. Empty means "relative", so requests go to /api/... on
# whatever address the site is served from. No backend URL to configure.
#
# `npm run dev` does not read this file and uses http://127.0.0.1:8002.
# For a local production build against a separate backend, set
# NEXT_PUBLIC_API_URL in the shell (it overrides this file).
NEXT_PUBLIC_API_URL=
